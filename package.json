{
  "name": "pi-claude-oauth",
  "version": "0.1.1",
  "description": "Use Claude Pro, Max, and Ultra subscription OAuth tokens from Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-claude-oauth.git"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "6",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.5",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
