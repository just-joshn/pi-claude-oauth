{
  "name": "pi-claude-oauth",
  "version": "0.1.0",
  "description": "Use Claude Pro, Max, and Ultra subscription OAuth tokens from Pi",
  "keywords": [
    "claude",
    "claude-code",
    "oauth",
    "pi-extension",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-claude-oauth.git"
  },
  "files": [
    "src/",
    "CHANGELOG.md"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "coverage": "node scripts/coverage.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@types/node": "^24.10.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "packageManager": "bun@1.4.5",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
