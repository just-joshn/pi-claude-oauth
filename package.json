{
	"name": "pi-claude-oauth",
	"version": "0.2.2",
	"description": "Use Claude Pro, Max, and Ultra subscription OAuth tokens from Pi",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/just-joshn/pi-claude-oauth.git"
	},
	"files": [
		"src/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": "^22.23.5 || ^24.22.3 || ^26.13.1"
	},
	"packageManager": "npm@11.20.0",
	"scripts": {
		"dev": "pi -e ./src/index.ts",
		"check": "biome ci --error-on-warnings . && tsc --noEmit",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run test/integration",
		"test:coverage": "vitest run --coverage",
		"bench": "node benchmarks/login.bench.ts",
		"audit": "npm audit --audit-level=high",
		"pack:check": "npm pack --dry-run --ignore-scripts",
		"test:package": "node scripts/smoke-package.ts",
		"verify": "npm run check && npm run test:coverage && npm run audit && npm run pack:check && npm run test:package"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.6.1",
		"@earendil-works/pi-coding-agent": "1.6.1",
		"@earendil-works/pi-tui": "1.6.1",
		"@biomejs/biome": "2.6.9",
		"@types/node": "22.19.19",
		"@vitest/coverage-v8": "4.1.12",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
